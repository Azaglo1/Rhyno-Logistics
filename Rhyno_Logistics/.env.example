# Oracle Database (EZ Connect: user/pass@host:port/service_name)
ORACLE_USER=your_user
ORACLE_PASSWORD=your_password
ORACLE_DSN=localhost:1521/XEPDB1

# Flask
FLASK_ENV=development
RHYNO_SECRET_KEY=generate-a-long-random-secret
# Use clearly labeled, non-bookable sample itineraries by default
FLIGHT_SEARCH_MODE=demo
# Optional Amadeus Self-Service test API credentials; used only when mode is amadeus
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_API_BASE_URL=https://test.api.amadeus.com
PUBLIC_BASE_URL=http://127.0.0.1:5000

# SMTP for contact enquiries and password-reset links
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
CONTACT_RECIPIENT=
SMTP_USE_TLS=1

# PayPal sandbox credentials; switch to live only after deployment review
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to 0 to require real PayPal credentials; defaults to 1 (demo mode)
PAYPAL_DEMO_MODE=1

# Paystack test or live secret key; used for GHS mobile-money checkout
PAYSTACK_SECRET_KEY=
# Set to 0 to require a real Paystack key; defaults to 1 (demo mode)
PAYSTACK_DEMO_MODE=1

# Optional first administrator account (only seeded if both are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=
